# Google OAuth2 credentials (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# The redirect URI must be listed among the "Authorized redirect URIs" of the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Frontend address: the browser is sent back here after login (also used as the CORS origin)
FRONTEND_URL=http://localhost:5173
# Optional, comma-separated: extra CORS origins (defaults to FRONTEND_URL)
# CORS_ORIGINS=

# Key used to sign session tokens: set it to a long random string
# (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
TOKEN_EXPIRE_HOURS=168

# Converter configuration (essential version of scripts/config.json)
CONFIG_FILE=config.json

# SQLAlchemy connection string (default: SQLite file in the current folder)
DATABASE_URL=sqlite:///./valpal.db
